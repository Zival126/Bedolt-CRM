# Mot de passe unique pour se connecter au CRM (le changer déconnecte toutes les sessions)
CRM_PASSWORD=change-moi
# Secret de signature du cookie de session — OBLIGATOIRE en production (32 caractères minimum),
# sinon le serveur refuse de démarrer. Générer : openssl rand -hex 32
SESSION_SECRET=
# URL publique du CRM — OBLIGATOIRE en production (base de toutes les redirections)
APP_URL=https://crm.bedolt.com
# Token DENUE (valeur par defaut ; modifiable ensuite dans Reglages > DENUE)
DENUE_TOKEN=
# Chemin de la base SQLite (defaut : ./data/crm.db)
DATABASE_PATH=./data/crm.db
# Port d'ecoute local (defaut 3100). Le serveur n'ecoute QUE sur 127.0.0.1.
PORT=3100
# Mettre a false uniquement pour tester en HTTP simple en mode production
COOKIE_SECURE=true
# Journal des connexions (echecs lus par fail2ban, optionnel). Defaut : ./logs/auth.log
# AUTH_LOG_PATH=./logs/auth.log

# --- IA : protection SSRF ---
# Hotes IA autorises en plus de Tailscale (100.64.0.0/10, *.ts.net) et des IP publiques, separes par des virgules.
# Ex. n8n sur le VPS lui-meme : AI_ALLOWED_HOSTS=127.0.0.1
AI_ALLOWED_HOSTS=
# Delai max sans donnees pendant le streaming du chat (ms, defaut 30000)
# AI_STREAM_IDLE_MS=30000

# --- Copie des sauvegardes hors VPS (optionnelle) ---
# Destination rclone (remote configure avec `rclone config` sous l'utilisateur bedoltcrm), ex. b2:mon-bucket/bedolt-crm
BACKUP_REMOTE=
# Chiffrement avant envoi (obligatoire si BACKUP_REMOTE) : cle publique age (recommande, la cle privee reste HORS du VPS)
BACKUP_AGE_RECIPIENT=
# ... ou phrase de passe gpg symetrique (si pas d'age)
BACKUP_GPG_PASSPHRASE=
# Duree de conservation distante en jours (defaut 30)
BACKUP_REMOTE_KEEP_DAYS=30

# --- Carte ---
# Fond de carte : osm (defaut, gratuit et sans cle, assombri) | carto (CARTO Dark Matter : exige desormais une cle CARTO)
# MAP_TILES=osm
# Geocodage (serveur uniquement, Nominatim/OpenStreetMap, 1 requete/seconde max, cache en base). off = desactive
# GEOCODER=on
# Veille DENUE (recherches enregistrees relancees chaque semaine) : off pour la desactiver.
# DENUE_WATCH=on
# --- Sources (v6) ---
# Enrichissement depuis le site web des fiches (email, reseaux, WhatsApp) : off pour le desactiver.
# ENRICHER=on
# Serveur Overpass (OpenStreetMap) essaye en premier. Sinon : liste reglable dans Reglages > Sources & cles
# (defaut : overpass-api.de, overpass.private.coffee, maps.mail.ru), bascule automatique si un serveur est sature.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Google Places (optionnel, payant au-dela du quota gratuit) : bouton « Verifier sur Google » des fiches.
# Sans cle, aucune requete n'est faite.
# GOOGLE_PLACES_KEY=
# NOMINATIM_URL=https://nominatim.openstreetmap.org
