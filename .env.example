# Mot de passe unique pour se connecter au CRM
CRM_PASSWORD=change-moi
# Secret pour signer le cookie de session (chaine aleatoire longue). Optionnel mais recommande.
SESSION_SECRET=
# Token DENUE (valeur par defaut ; modifiable ensuite dans Reglages > DENUE)
DENUE_TOKEN=
# Chemin de la base SQLite (defaut : ./data/crm.db)
DATABASE_PATH=./data/crm.db
# Port d'ecoute (defaut 3100)
PORT=3100
# Mettre a false uniquement pour tester en HTTP simple en mode production
COOKIE_SECURE=true
