# Jail fail2ban optionnelle : 10 échecs en 1 h depuis une IP -> bannie 24 h au pare-feu (tous ports).
# Le CRM bloque déjà seul (5 échecs -> 15 min, puis 30, 60...) ; fail2ban ajoute un blocage au niveau réseau.
[bedolt-crm]
enabled   = true
filter    = bedolt-crm
logpath   = /var/www/bedolt-crm/logs/auth.log
logtimezone = UTC
maxretry  = 10
findtime  = 3600
bantime   = 86400
# CyberPanel utilise firewalld : décommente la ligne adaptée (sinon l'action par défaut de fail2ban s'applique).
# banaction = firewallcmd-rich-rules
# banaction = csf-ip-deny   (si CSF est installé)
